{
  "rules": {
    ".read": false,
    ".write": false,
    "shared": {
      "$roundKey": {
        ".read": "auth != null && $roundKey.matches(/^round-[ABCDEFGHJKMNPQRSTUVWXY3456789]{5}-(state|chat)$/)",
        ".write": "auth != null && $roundKey.matches(/^round-[ABCDEFGHJKMNPQRSTUVWXY3456789]{5}-(state|chat)$/)",
        ".validate": "newData.hasChildren() || newData.val() == null"
      }
    },
    "private": {
      "$deviceId": { "$key": { ".read": "auth != null", ".write": "auth != null" } }
    }
  }
}